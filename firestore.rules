rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerEmail() {
      return isVerifiedUser()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'alobli456@gmail.com';
    }

    function isAdmin() {
      return isOwnerEmail() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPublicPlatform(p) {
      return p is map
        && p.keys().hasAll(['id', 'name', 'shortName', 'connected', 'handle', 'channelUrl', 'apiMode', 'maxDurationSec', 'maxCaptionLength', 'lastSyncedAt'])
        && p.keys().hasOnly(['id', 'name', 'shortName', 'connected', 'handle', 'channelUrl', 'apiMode', 'maxDurationSec', 'maxCaptionLength', 'lastSyncedAt'])
        && p.id is string && p.id.size() <= 32
        && p.name is string && p.name.size() <= 60
        && p.shortName is string && p.shortName.size() <= 40
        && p.connected is bool
        && p.handle is string && p.handle.size() <= 100
        && p.channelUrl is string && p.channelUrl.size() <= 300
        && p.apiMode is string && p.apiMode.size() <= 32
        && p.lastSyncedAt is string && p.lastSyncedAt.size() <= 64;
    }

    function isValidPublicSettings(data) {
      return data.keys().hasAll([
          'platforms',
          'mediaChannels',
          'whatsAppConfig',
          'gmailConfig',
          'updatedBy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'platforms',
          'mediaChannels',
          'whatsAppConfig',
          'gmailConfig',
          'updatedBy',
          'updatedAt'
        ])
        && data.platforms is map
        && data.platforms.keys().hasAll(['tiktok', 'instagram', 'youtube', 'snapchat'])
        && data.platforms.keys().hasOnly(['tiktok', 'instagram', 'youtube', 'snapchat'])
        && isValidPublicPlatform(data.platforms.tiktok)
        && isValidPublicPlatform(data.platforms.instagram)
        && isValidPublicPlatform(data.platforms.youtube)
        && isValidPublicPlatform(data.platforms.snapchat)
        && data.mediaChannels is list
        && data.mediaChannels.size() <= 25
        && (data.mediaChannels.size() == 0 || data.mediaChannels[0] is map)
        && data.whatsAppConfig is map
        && data.whatsAppConfig.keys().hasAll(['enabled', 'phoneNumber', 'displayName', 'defaultMessage'])
        && data.whatsAppConfig.keys().hasOnly(['enabled', 'phoneNumber', 'displayName', 'defaultMessage'])
        && data.whatsAppConfig.enabled is bool
        && data.whatsAppConfig.phoneNumber is string
        && data.whatsAppConfig.phoneNumber.size() <= 40
        && data.whatsAppConfig.displayName is string
        && data.whatsAppConfig.displayName.size() <= 100
        && data.whatsAppConfig.defaultMessage is string
        && data.whatsAppConfig.defaultMessage.size() <= 300
        && data.gmailConfig is map
        && data.gmailConfig.keys().hasAll(['enabled', 'email', 'displayName', 'defaultSubject', 'defaultMessage'])
        && data.gmailConfig.keys().hasOnly(['enabled', 'email', 'displayName', 'defaultSubject', 'defaultMessage'])
        && data.gmailConfig.enabled is bool
        && data.gmailConfig.email is string
        && data.gmailConfig.email.size() <= 180
        && data.gmailConfig.displayName is string
        && data.gmailConfig.displayName.size() <= 100
        && data.gmailConfig.defaultSubject is string
        && data.gmailConfig.defaultSubject.size() <= 150
        && data.gmailConfig.defaultMessage is string
        && data.gmailConfig.defaultMessage.size() <= 500
        && data.updatedBy is string
        && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidPrivateCredentials(data) {
      return data.keys().hasAll(['updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'tiktokClientId',
          'tiktokWebhook',
          'instagramClientId',
          'instagramWebhook',
          'youtubeClientId',
          'youtubeWebhook',
          'snapchatClientId',
          'snapchatWebhook',
          'updatedBy',
          'updatedAt'
        ])
        && (!('tiktokClientId' in data) || (data.tiktokClientId is string && data.tiktokClientId.size() <= 200))
        && (!('tiktokWebhook' in data) || (data.tiktokWebhook is string && data.tiktokWebhook.size() <= 400))
        && (!('instagramClientId' in data) || (data.instagramClientId is string && data.instagramClientId.size() <= 200))
        && (!('instagramWebhook' in data) || (data.instagramWebhook is string && data.instagramWebhook.size() <= 400))
        && (!('youtubeClientId' in data) || (data.youtubeClientId is string && data.youtubeClientId.size() <= 200))
        && (!('youtubeWebhook' in data) || (data.youtubeWebhook is string && data.youtubeWebhook.size() <= 400))
        && (!('snapchatClientId' in data) || (data.snapchatClientId is string && data.snapchatClientId.size() <= 200))
        && (!('snapchatWebhook' in data) || (data.snapchatWebhook is string && data.snapchatWebhook.size() <= 400))
        && data.updatedBy is string
        && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'email',
          'role',
          'status',
          'lastActiveAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'email',
          'role',
          'status',
          'lastActiveAt',
          'avatarUrl',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 180
        && data.role in ['admin', 'creator', 'editor', 'viewer']
        && data.status in ['active', 'invited']
        && data.lastActiveAt is string
        && data.lastActiveAt.size() <= 64
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && data.updatedAt is timestamp;
    }

    function isValidUserAccount(data, uid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'language',
          'role',
          'onboardingComplete',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoUrl',
          'language',
          'role',
          'onboardingComplete',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 180
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && data.email.lower() == request.auth.token.email.lower()
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.language in ['en', 'ur', 'roman-ur', 'ar', 'es', 'fr']
        && data.role == 'creator'
        && data.onboardingComplete is bool
        && data.updatedAt is timestamp;
    }

    match /workspace_config/{docId} {
      allow get: if isVerifiedUser() && isValidId(docId) && docId == 'public_settings';
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(docId)
        && docId == 'public_settings'
        && isValidPublicSettings(incoming())
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(docId)
        && docId == 'public_settings'
        && isValidPublicSettings(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'platforms',
          'mediaChannels',
          'whatsAppConfig',
          'gmailConfig',
          'updatedBy',
          'updatedAt'
        ])
        && isAdmin();
      allow delete: if false;
    }

    match /workspace_private/{docId} {
      allow get: if isVerifiedUser()
        && isValidId(docId)
        && docId == 'api_credentials'
        && isAdmin();
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(docId)
        && docId == 'api_credentials'
        && isValidPrivateCredentials(incoming())
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(docId)
        && docId == 'api_credentials'
        && isValidPrivateCredentials(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'tiktokClientId',
          'tiktokWebhook',
          'instagramClientId',
          'instagramWebhook',
          'youtubeClientId',
          'youtubeWebhook',
          'snapchatClientId',
          'snapchatWebhook',
          'updatedBy',
          'updatedAt'
        ])
        && isAdmin();
      allow delete: if false;
    }

    match /team_members/{memberId} {
      allow get: if isVerifiedUser() && isValidId(memberId) && isAdmin();
      allow list: if isOwnerEmail();
      allow create: if isVerifiedUser()
        && isValidId(memberId)
        && incoming().id == memberId
        && isValidTeamMember(incoming())
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(memberId)
        && isValidTeamMember(incoming())
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'email',
          'role',
          'status',
          'lastActiveAt',
          'avatarUrl',
          'updatedAt'
        ])
        && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(memberId) && isAdmin();
    }

    match /users/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isOwnerEmail();
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserAccount(incoming(), uid)
        && incoming().createdAt is timestamp;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserAccount(incoming(), uid)
        && incoming().createdAt == existing().createdAt
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoUrl',
          'language',
          'onboardingComplete',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
  }
}
